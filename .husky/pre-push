#!/usr/bin/env sh
BOLD='\033[1m'
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
RESET='\033[0m'

print_line() {
  printf '%b\n' "$1"
}

print_line ""
print_line "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
print_line "${CYAN}${BOLD}  🚀 Pre-push Check                               ${RESET}"
print_line "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
print_line ""

TOTAL=3
STEP=1

run_step() {
  CMD="$*"

  print_line "${YELLOW}${BOLD}[$STEP/$TOTAL] Running pnpm run $CMD...${RESET}"
  print_line "${CYAN}──────────────────────────────────────────────────${RESET}"

  if ! pnpm run "$@"; then
    print_line ""
    print_line "${RED}${BOLD}✖ '$CMD' failed — push aborted${RESET}"
    print_line ""
    exit 1
  fi

  print_line "${GREEN}✔ $CMD passed${RESET}"
  print_line ""
  STEP=$((STEP + 1))
}

run_step type-check
run_step lint

print_line "${YELLOW}${BOLD}Updating origin/dev before changed tests...${RESET}"
if ! git fetch origin dev --quiet; then
  print_line ""
  print_line "${RED}${BOLD}✖ failed to fetch origin/dev — push aborted${RESET}"
  print_line ""
  exit 1
fi
print_line "${GREEN}✔ origin/dev updated${RESET}"
print_line ""

run_step test --changed origin/dev

print_line "${GREEN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
print_line "${GREEN}${BOLD}  ✅ All checks passed! Pushing...                ${RESET}"
print_line "${GREEN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
print_line ""
