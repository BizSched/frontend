#!/usr/bin/env bash
BOLD='\033[1m'
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
RESET='\033[0m'

echo ""
echo -e "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "${CYAN}${BOLD}  🚀 Pre-push Check                               ${RESET}"
echo -e "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo ""

STEPS=("type-check" "lint" "test --changed origin/dev")
TOTAL=${#STEPS[@]}
STEP=1

for CMD in "${STEPS[@]}"; do
  echo -e "${YELLOW}${BOLD}[$STEP/$TOTAL] Running pnpm run $CMD...${RESET}"
  echo -e "${CYAN}──────────────────────────────────────────────────${RESET}"

  if ! pnpm run "$CMD"; then
    echo ""
    echo -e "${RED}${BOLD}✖ '$CMD' failed — push aborted${RESET}"
    echo ""
    exit 1
  fi

  echo -e "${GREEN}✔ $CMD passed${RESET}"
  echo ""
  STEP=$((STEP + 1))
done

echo -e "${GREEN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "${GREEN}${BOLD}  ✅ All checks passed! Pushing...                ${RESET}"
echo -e "${GREEN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo ""